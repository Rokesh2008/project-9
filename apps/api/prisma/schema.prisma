generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MEMBER 2 - ENUMS
// ==========================================

enum Role {
  ADMIN
  PLACEMENT_COORDINATOR
  COORDINATOR
  PEP_STAFF
  STUDENT
}

enum WorkflowState {
  IMPORTED
  ELIGIBILITY
  HOPE_PEP
  COMMUNICATION
  INTERVIEW
  SELECTION
  ALLOCATION
  ADMIN_REVIEW
  FINALIZED
  FROZEN
}

enum CycleStatus {
  DRAFT
  ACTIVE
  FROZEN
  COMPLETED
  ARCHIVED
}

enum AssessmentType {
  CODING
  COMMUNICATION
  TECHNICAL
  INTERVIEW
  APTITUDE
  GPA
  OTHER
}

enum AllocationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  FROZEN
  MANUAL_REVIEW
}

enum AdminDecisionType {
  APPROVE_ALLOCATION
  OVERRIDE_ALLOCATION
  REJECT_ALLOCATION
  REQUEST_RE_ALLOCATION
  SPECIAL_CONSIDERATION
}

enum NotificationType {
  WORKFLOW_TRANSITION
  PREFERENCE_SUBMITTED
  SELECTION_STATUS
  ALLOCATION_RESULT
  ADMIN_DECISION
  FINALIZATION
  FREEZE
  GENERAL
}

// ==========================================
// MEMBER 2 - CORE ENTITIES
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STUDENT)
  studentId String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  batches   Batch[]
}

model Batch {
  id              String     @id @default(uuid())
  batchIdentifier String     @unique
  academicYear    String
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  status          String     @default("ACTIVE")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  students        Student[]

  @@index([departmentId])
  @@index([academicYear])
}

model Student {
  id                String               @id @default(uuid())
  studentId         String               @unique
  name              String
  email             String               @unique
  contactNo         String?
  batchId           String
  batch             Batch                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User?
  assessmentResults AssessmentResult[]
  preferences       StudentPreference[]
  cycleStatuses     StudentCycleStatus[]
  allocations       Allocation[]
  adminDecisions    AdminDecision[]
  workflowAudits    WorkflowAuditLog[]
  // Member 1 reverse relations
  eligibilityResults      EligibilityResult[]
  studentScores           StudentScore[]
  studentRankings         StudentRanking[]
  snapshotEntries         RankingSnapshotEntry[]
  hopePepClassifications  HopePepClassification[]

  @@index([batchId])
  @@index([studentId])
  @@index([email])
}

model SelectionCycle {
  id                   String               @id @default(uuid())
  code                 String               @unique
  name                 String
  academicPeriod       String
  startDate            DateTime
  endDate              DateTime
  status               CycleStatus          @default(ACTIVE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  studentCycleStatuses StudentCycleStatus[]
  preferences          StudentPreference[]
  allocations          Allocation[]
  adminDecisions       AdminDecision[]
  workflowAudits       WorkflowAuditLog[]
  // Member 1 reverse relations
  cycleConfig              CycleConfig?
  eligibilityRuleVersions  EligibilityRuleVersion[]
  eligibilityResults       EligibilityResult[]
  weightVersions           WeightVersion[]
  studentScores            StudentScore[]
  studentRankings          StudentRanking[]
  freezeSchedules          FreezeSchedule[]
  rankingSnapshots         RankingSnapshot[]
  hopePepClassifications   HopePepClassification[]
  scoreAuditLogs              ScoreAuditLog[]
  freezeNotificationEvents    FreezeNotificationEvent[]
}

model AssessmentResult {
  id               String         @id @default(uuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourceIdentifier String
  assessmentType   AssessmentType @default(TECHNICAL)
  score            Float
  maxScore         Float          @default(100.0)
  percentage       Float?
  attemptNumber    Int            @default(1)
  assessmentDate   DateTime       @default(now())
  metadata         Json?
  createdAt        DateTime       @default(now())

  @@index([studentId, assessmentType])
  @@index([studentId, createdAt])
}

model Program {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  domains     Domain[]
}

model Domain {
  id              String              @id @default(uuid())
  programId       String
  program         Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  code            String              @unique
  name            String
  description     String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  requirements    DomainRequirement[]
  trainingBatches TrainingBatch[]
  preferences     StudentPreference[]
  allocations     Allocation[]

  @@index([programId])
}

model DomainRequirement {
  id              String   @id @default(uuid())
  domainId        String
  domain          Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  requirementType String
  requirementKey  String
  minimumValue    Float?
  stringValue     String?
  isMandatory     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([domainId])
}

model TrainingBatch {
  id               String       @id @default(uuid())
  domainId         String
  domain           Domain       @relation(fields: [domainId], references: [id], onDelete: Restrict)
  batchCode        String       @unique
  batchName        String
  startDate        DateTime?
  endDate          DateTime?
  scheduleInfo     String?
  maxCapacity      Int
  currentAllocated Int          @default(0)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  allocations      Allocation[]

  @@index([domainId])
}

model StudentPreference {
  id               String         @id @default(uuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectionCycleId String
  selectionCycle   SelectionCycle @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  domainId         String
  domain           Domain         @relation(fields: [domainId], references: [id], onDelete: Restrict)
  preferenceRank   Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentId, selectionCycleId, preferenceRank])
  @@unique([studentId, selectionCycleId, domainId])
  @@index([studentId, selectionCycleId])
}

model StudentCycleStatus {
  id               String             @id @default(uuid())
  studentId        String
  student          Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectionCycleId String
  selectionCycle   SelectionCycle     @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  currentState     WorkflowState      @default(IMPORTED)
  isFrozen         Boolean            @default(false)
  frozenAt         DateTime?
  frozenBy         String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  auditLogs        WorkflowAuditLog[]

  @@unique([studentId, selectionCycleId])
  @@index([studentId, selectionCycleId])
}

model WorkflowAuditLog {
  id                   String              @id @default(uuid())
  studentCycleStatusId String?
  studentCycleStatus   StudentCycleStatus? @relation(fields: [studentCycleStatusId], references: [id], onDelete: SetNull)
  studentId            String
  student              Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectionCycleId     String
  selectionCycle       SelectionCycle      @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  fromState            WorkflowState
  toState              WorkflowState
  actor                String
  role                 String
  reason               String?
  metadata             Json?
  createdAt            DateTime            @default(now())

  @@index([studentId, selectionCycleId])
  @@index([createdAt])
}

model Allocation {
  id                       String           @id @default(uuid())
  studentId                String
  student                  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectionCycleId         String
  selectionCycle           SelectionCycle   @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  domainId                 String?
  domain                   Domain?          @relation(fields: [domainId], references: [id], onDelete: SetNull)
  trainingBatchId          String?
  trainingBatch            TrainingBatch?   @relation(fields: [trainingBatchId], references: [id], onDelete: SetNull)
  status                   AllocationStatus @default(PENDING_APPROVAL)
  preferenceRankUsed       Int?
  selectionResultReference String?
  failureReason            String?
  allocatedAt              DateTime         @default(now())
  isFinalized              Boolean          @default(false)
  finalizedAt              DateTime?
  finalizedBy              String?
  isFrozen                 Boolean          @default(false)
  frozenAt                 DateTime?
  frozenBy                 String?
  metadata                 Json?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@unique([studentId, selectionCycleId])
  @@index([selectionCycleId, status])
}

model AdminDecision {
  id               String            @id @default(uuid())
  studentId        String
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectionCycleId String
  selectionCycle   SelectionCycle    @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  decisionType     AdminDecisionType
  reason           String
  actor            String
  role             String
  targetDomainId   String?
  targetBatchId    String?
  metadata         Json?
  createdAt        DateTime          @default(now())

  @@index([studentId, selectionCycleId])
  @@index([createdAt])
}

model Notification {
  id                String           @id @default(uuid())
  recipient         String
  recipientRole     String?
  type              NotificationType @default(GENERAL)
  title             String
  message           String
  isRead            Boolean          @default(false)
  readAt            DateTime?
  relatedEntityType String?
  relatedEntityId   String?
  metadata          Json?
  createdAt         DateTime         @default(now())

  @@index([recipient, isRead])
  @@index([createdAt])
}

// ==========================================
// MEMBER 1 - ENUMS
// ==========================================

enum FreezeStatus {
  SCHEDULED
  EXECUTED
  CANCELLED
  POSTPONED
}

enum FreezeNotificationEventType {
  FREEZE_SCHEDULED
  FREEZE_7_DAYS_BEFORE
  FREEZE_24_HOURS_BEFORE
  FREEZE_1_HOUR_BEFORE
  FREEZE_EXECUTED
}

enum FreezeNotificationStatus {
  PENDING
  SENT
  CANCELLED
  SKIPPED
}

enum ClassificationStatus {
  CLASSIFIED
  HOPE_INTERVIEW_FAILED
  PEP_FALLBACK_ALLOWED
  PEP_FALLBACK_DENIED
}

// ==========================================
// MEMBER 1 - ELIGIBILITY, RANKING & SELECTION ENGINE
// ==========================================

model CycleConfig {
  id                       String                  @id @default(uuid())
  selectionCycleId         String                  @unique
  selectionCycle           SelectionCycle           @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  activeWeightVersionId    String?
  activeWeightVersion      WeightVersion?           @relation("CycleActiveWeight", fields: [activeWeightVersionId], references: [id], onDelete: SetNull)
  hopeCount                Int
  pepCount                 Int
  eligibilityRuleVersionId String?
  activeEligibilityRule    EligibilityRuleVersion?  @relation("CycleActiveRule", fields: [eligibilityRuleVersionId], references: [id], onDelete: SetNull)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
}

model EligibilityRuleVersion {
  id                 String              @id @default(uuid())
  selectionCycleId   String
  selectionCycle     SelectionCycle      @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  version            Int
  rules              Json
  description        String?
  createdBy          String
  isActive           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  cycleConfigs       CycleConfig[]       @relation("CycleActiveRule")
  eligibilityResults EligibilityResult[]
  rankingSnapshots   RankingSnapshot[]   @relation("SnapshotRuleVersion")

  @@unique([selectionCycleId, version])
  @@index([selectionCycleId, isActive])
}

model EligibilityResult {
  id               String                 @id @default(uuid())
  studentId        String
  student          Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectionCycleId String
  selectionCycle   SelectionCycle         @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  ruleVersionId    String
  ruleVersion      EligibilityRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  isEligible       Boolean
  failedRules      Json?
  evaluatedAt      DateTime               @default(now())

  @@unique([studentId, selectionCycleId])
  @@index([selectionCycleId, isEligible])
}

model WeightVersion {
  id               String            @id @default(uuid())
  selectionCycleId String
  selectionCycle   SelectionCycle    @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  version          Int
  description      String?
  createdBy        String
  createdAt        DateTime          @default(now())
  weights          ParameterWeight[]
  cycleConfigs     CycleConfig[]     @relation("CycleActiveWeight")
  studentScores    StudentScore[]
  studentRankings  StudentRanking[]
  rankingSnapshots RankingSnapshot[] @relation("SnapshotWeightVersion")

  @@unique([selectionCycleId, version])
  @@index([selectionCycleId])
}

model ParameterWeight {
  id              String        @id @default(uuid())
  weightVersionId String
  weightVersion   WeightVersion @relation(fields: [weightVersionId], references: [id], onDelete: Cascade)
  parameterKey    String
  parameterLabel  String
  weight          Float
  maxRawScore     Float
  sortOrder       Int

  @@unique([weightVersionId, parameterKey])
}

model StudentScore {
  id               String         @id @default(uuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectionCycleId String
  selectionCycle   SelectionCycle @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  weightVersionId  String
  weightVersion    WeightVersion  @relation(fields: [weightVersionId], references: [id], onDelete: Restrict)
  parameterKey     String
  rawScore         Float
  isMissing        Boolean        @default(false)
  normalizedScore  Float
  weight           Float
  weightedScore    Float
  calculatedAt     DateTime       @default(now())

  @@unique([studentId, selectionCycleId, weightVersionId, parameterKey])
  @@index([selectionCycleId, weightVersionId])
}

model StudentRanking {
  id               String         @id @default(uuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectionCycleId String
  selectionCycle   SelectionCycle @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  weightVersionId  String
  weightVersion    WeightVersion  @relation(fields: [weightVersionId], references: [id], onDelete: Restrict)
  totalScore       Float
  rank             Int
  percentile       Float?
  tieBreakApplied  Boolean        @default(false)
  calculatedAt     DateTime       @default(now())

  @@unique([studentId, selectionCycleId])
  @@index([selectionCycleId, rank])
  @@index([selectionCycleId, totalScore])
}

model FreezeSchedule {
  id               String           @id @default(uuid())
  selectionCycleId String
  selectionCycle   SelectionCycle   @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  scheduledAt      DateTime
  status           FreezeStatus     @default(SCHEDULED)
  executedAt       DateTime?
  snapshotId       String?
  snapshot         RankingSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  scheduledBy      String
  cancelledBy      String?
  cancelReason     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  notificationEvents FreezeNotificationEvent[]

  @@index([selectionCycleId, status])
  @@index([scheduledAt, status])
}

model RankingSnapshot {
  id               String                  @id @default(uuid())
  selectionCycleId String
  selectionCycle   SelectionCycle          @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  version          Int
  weightVersionId  String
  weightVersion    WeightVersion           @relation("SnapshotWeightVersion", fields: [weightVersionId], references: [id], onDelete: Restrict)
  ruleVersionId    String?
  ruleVersion      EligibilityRuleVersion? @relation("SnapshotRuleVersion", fields: [ruleVersionId], references: [id], onDelete: SetNull)
  hopeCount        Int
  pepCount         Int
  totalStudents    Int
  frozenAt         DateTime                @default(now())
  frozenBy         String
  reason           String?
  entries          RankingSnapshotEntry[]
  freezeSchedules  FreezeSchedule[]
  classifications  HopePepClassification[]

  @@unique([selectionCycleId, version])
  @@index([selectionCycleId])
}

model RankingSnapshotEntry {
  id                  String          @id @default(uuid())
  snapshotId          String
  snapshot            RankingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rank                Int
  totalScore          Float
  percentile          Float?
  parameterScores     Json
  isEligible          Boolean
  eligibilityFailures Json?
  program             String?
  tieBreakApplied     Boolean         @default(false)

  @@unique([snapshotId, studentId])
  @@index([snapshotId, rank])
  @@index([snapshotId, program])
}

model HopePepClassification {
  id                  String               @id @default(uuid())
  studentId           String
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectionCycleId    String
  selectionCycle      SelectionCycle       @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  snapshotId          String?
  snapshot            RankingSnapshot?     @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  program             String
  rank                Int
  status              ClassificationStatus @default(CLASSIFIED)
  adminDecisionBy     String?
  adminDecisionAt     DateTime?
  adminDecisionReason String?
  classifiedAt        DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([studentId, selectionCycleId])
  @@index([selectionCycleId, program])
  @@index([selectionCycleId, status])
}

model ScoreAuditLog {
  id               String         @id @default(uuid())
  selectionCycleId String
  selectionCycle   SelectionCycle @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  action           String
  actor            String
  role             String?
  entityType       String?
  entityId         String?
  previousValue    Json?
  newValue         Json?
  reason           String?
  metadata         Json?
  createdAt        DateTime       @default(now())

  @@index([selectionCycleId, action])
  @@index([selectionCycleId, createdAt])
  @@index([entityType, entityId])
}

model FreezeNotificationEvent {
  id               String                      @id @default(uuid())
  selectionCycleId String
  selectionCycle   SelectionCycle              @relation(fields: [selectionCycleId], references: [id], onDelete: Cascade)
  freezeScheduleId String
  freezeSchedule   FreezeSchedule              @relation(fields: [freezeScheduleId], references: [id], onDelete: Cascade)
  eventType        FreezeNotificationEventType
  plannedAt        DateTime
  status           FreezeNotificationStatus    @default(PENDING)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([freezeScheduleId, eventType])
  @@index([selectionCycleId])
  @@index([freezeScheduleId])
  @@index([status, plannedAt])
}

// ==========================================
// MEMBER 3 - INTEGRATION & AI MODELS
// ==========================================

enum IntegrationStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  DUPLICATE
}

enum RecommendationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  VERIFIED
}

model IntegrationSource {
  id         Int              @id @default(autoincrement())
  code       String           @unique
  name       String
  enabled    Boolean          @default(true)
  lastSeenAt DateTime?
  jobs       IntegrationJob[]
}

model IntegrationJob {
  id             String            @id @default(uuid())
  sourceId       Int
  source         IntegrationSource @relation(fields: [sourceId], references: [id])
  operation      String
  method         String
  idempotencyKey String            @unique
  status         IntegrationStatus @default(PROCESSING)
  recordCount    Int               @default(0)
  startedAt      DateTime          @default(now())
  endedAt        DateTime?
  error          Json?
  logs           IntegrationLog[]
}

model IntegrationLog {
  id        String         @id @default(uuid())
  jobId     String
  job       IntegrationJob @relation(fields: [jobId], references: [id])
  level     String
  message   String
  details   Json?
  createdAt DateTime       @default(now())
}

model ExternalReference {
  id         String @id @default(uuid())
  sourceCode String
  entityType String
  externalId String
  internalId String
  sourceMeta Json?

  @@unique([sourceCode, entityType, externalId])
}

model AiStudentAnalysis {
  id                 String   @id @default(uuid())
  studentId          String
  strengths          Json
  gaps               Json
  trend              String
  recommendedDomains Json
  modelVersion       String
  advisoryOnly       Boolean  @default(true)
  generatedAt        DateTime @default(now())

  @@index([studentId, generatedAt])
}

model AgentRun {
  id              String                @id @default(uuid())
  cycleId         Int?
  state           String
  context         Json
  startedAt       DateTime              @default(now())
  completedAt     DateTime?
  recommendations AgentRecommendation[]
}

model AgentRecommendation {
  id                String               @id @default(uuid())
  runId             String
  run               AgentRun             @relation(fields: [runId], references: [id])
  studentId         String
  recommendedDomain String
  rationale         Json
  conflicts         Json
  status            RecommendationStatus @default(PENDING_APPROVAL)
  approvedBy        String?
  approvedAt        DateTime?
  verifiedAt        DateTime?
}

model ReportSnapshot {
  id          String   @id @default(uuid())
  reportType  String
  cycleId     Int?
  filters     Json?
  totals      Json
  storagePath String?
  createdAt   DateTime @default(now())
}
